{
  "name": "@massage-desk/api-types",
  "version": "0.1.0",
  "private": true,
  "license": "MIT",
  "type": "module",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "types": "./src/index.ts"
    }
  },
  "files": [
    "src"
  ],
  "scripts": {
    "generate": "openapi-typescript ../../apps/api/openapi.json -o src/schema.ts",
    "check:generated": "openapi-typescript ../../apps/api/openapi.json -o src/schema.ts --check",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "eslint": "^9.39.5",
    "openapi-typescript": "^7.13.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5"
  }
}
