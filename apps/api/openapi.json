{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "REST API for the massage-desk app and admin panel",
    "title" : "massage-desk API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "paths" : {
    "/appointments" : {
      "post" : {
        "operationId" : "createAppointment",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateAppointmentRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AppointmentResponse"
                }
              }
            },
            "description" : "appointment created"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "missing or invalid field"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "client or service not found, or service inactive"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "the time is already booked"
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "outside working hours, in time off or in the past"
          }
        },
        "summary" : "Book a service for a client",
        "tags" : [ "booking" ]
      }
    },
    "/appointments/{id}/cancel" : {
      "post" : {
        "operationId" : "cancelAppointment",
        "parameters" : [ {
          "description" : "appointment id",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AppointmentResponse"
                }
              }
            },
            "description" : "appointment cancelled"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "invalid id"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "appointment not found"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "the appointment is not confirmed"
          }
        },
        "summary" : "Cancel an appointment",
        "tags" : [ "booking" ]
      }
    },
    "/appointments/{id}/no-show" : {
      "post" : {
        "operationId" : "markNoShow",
        "parameters" : [ {
          "description" : "appointment id",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AppointmentResponse"
                }
              }
            },
            "description" : "appointment marked as no-show"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "invalid id"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "appointment not found"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "the appointment is not confirmed or has not started yet"
          }
        },
        "summary" : "Mark that the client did not come",
        "tags" : [ "booking" ]
      }
    },
    "/appointments/{id}/reschedule" : {
      "post" : {
        "operationId" : "rescheduleAppointment",
        "parameters" : [ {
          "description" : "appointment id",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/RescheduleAppointmentRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/AppointmentResponse"
                }
              }
            },
            "description" : "appointment moved"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "missing or invalid field or id"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "appointment not found"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "the time is already booked, or the appointment is not confirmed"
          },
          "422" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "outside working hours, in time off or in the past"
          }
        },
        "summary" : "Move an appointment to another start, keeping its length",
        "tags" : [ "booking" ]
      }
    },
    "/clients" : {
      "get" : {
        "operationId" : "listClients",
        "parameters" : [ {
          "description" : "name fragment or phone digits; blank lists everyone",
          "in" : "query",
          "name" : "q",
          "required" : false,
          "schema" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          }
        }, {
          "description" : "page size, 1..200",
          "in" : "query",
          "name" : "limit",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 50,
            "maximum" : 200,
            "minimum" : 1
          }
        }, {
          "description" : "rows to skip",
          "in" : "query",
          "name" : "offset",
          "required" : false,
          "schema" : {
            "type" : "integer",
            "format" : "int32",
            "default" : 0,
            "minimum" : 0
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "type" : "array",
                  "items" : {
                    "$ref" : "#/components/schemas/ClientResponse"
                  }
                }
              }
            },
            "description" : "clients, alphabetically by name"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "invalid query parameter"
          }
        },
        "summary" : "List clients or search them by name or phone",
        "tags" : [ "clients" ]
      },
      "post" : {
        "operationId" : "createClient",
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/CreateClientRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "201" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClientResponse"
                }
              }
            },
            "description" : "client created"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "missing or invalid field, or invalid phone number"
          },
          "409" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "a client with this phone already exists"
          }
        },
        "summary" : "Add a client",
        "tags" : [ "clients" ]
      }
    },
    "/clients/{id}" : {
      "get" : {
        "operationId" : "getClient",
        "parameters" : [ {
          "description" : "client id",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClientResponse"
                }
              }
            },
            "description" : "the client"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "invalid id"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "client not found"
          }
        },
        "summary" : "Get one client",
        "tags" : [ "clients" ]
      },
      "patch" : {
        "operationId" : "updateClient",
        "parameters" : [ {
          "description" : "client id",
          "in" : "path",
          "name" : "id",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        } ],
        "requestBody" : {
          "content" : {
            "application/json" : {
              "schema" : {
                "$ref" : "#/components/schemas/UpdateClientRequest"
              }
            }
          },
          "required" : true
        },
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ClientResponse"
                }
              }
            },
            "description" : "client updated"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "invalid field or id"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "client not found"
          }
        },
        "summary" : "Change a client's name or notes",
        "tags" : [ "clients" ]
      }
    },
    "/slots" : {
      "get" : {
        "operationId" : "slots",
        "parameters" : [ {
          "description" : "id of an active service",
          "in" : "query",
          "name" : "serviceId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "description" : "local date in the master's time zone, YYYY-MM-DD",
          "in" : "query",
          "name" : "day",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SlotsResponse"
                }
              }
            },
            "description" : "free start times, possibly empty"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "invalid or missing serviceId or day"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "service not found or inactive"
          }
        },
        "summary" : "Free start times for a service on a day",
        "tags" : [ "schedule" ]
      }
    },
    "/webhook/whatsapp" : {
      "get" : {
        "operationId" : "verify",
        "parameters" : [ {
          "in" : "query",
          "name" : "hub.mode",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "hub.verify_token",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "hub.challenge",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            },
            "description" : "challenge echoed"
          },
          "403" : {
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            },
            "description" : "wrong or missing verify token"
          }
        },
        "security" : [ ],
        "summary" : "Meta webhook verification",
        "tags" : [ "webhook" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "AppointmentResponse" : {
        "type" : "object",
        "properties" : {
          "clientId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "end" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "ISO-8601 with the master's UTC offset"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "serviceId" : {
            "type" : "string",
            "format" : "uuid"
          },
          "source" : {
            "type" : "string",
            "enum" : [ "bot", "manual" ]
          },
          "start" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "ISO-8601 with the master's UTC offset"
          },
          "status" : {
            "type" : "string",
            "enum" : [ "confirmed", "cancelled", "no_show", "done" ]
          }
        },
        "required" : [ "clientId", "end", "id", "serviceId", "source", "start", "status" ]
      },
      "ClientResponse" : {
        "type" : "object",
        "properties" : {
          "createdAt" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "ISO-8601 with the master's UTC offset"
          },
          "id" : {
            "type" : "string",
            "format" : "uuid"
          },
          "name" : {
            "type" : [ "string", "null" ]
          },
          "notes" : {
            "type" : [ "string", "null" ]
          },
          "phone" : {
            "type" : "string",
            "description" : "E.164, for example +998901234567"
          }
        },
        "required" : [ "createdAt", "id", "name", "notes", "phone" ]
      },
      "CreateAppointmentRequest" : {
        "type" : "object",
        "properties" : {
          "clientId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "id of an existing client"
          },
          "serviceId" : {
            "type" : "string",
            "format" : "uuid",
            "description" : "id of an active service"
          },
          "start" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "ISO-8601 with offset; the end is start plus the service length"
          }
        },
        "required" : [ "clientId", "serviceId", "start" ]
      },
      "CreateClientRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "maxLength" : 100,
            "minLength" : 0
          },
          "notes" : {
            "type" : "string",
            "maxLength" : 2000,
            "minLength" : 0
          },
          "phone" : {
            "type" : "string",
            "description" : "any format; stored as E.164",
            "maxLength" : 32,
            "minLength" : 0
          }
        },
        "required" : [ "phone" ]
      },
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        }
      },
      "RescheduleAppointmentRequest" : {
        "type" : "object",
        "properties" : {
          "start" : {
            "type" : "string",
            "format" : "date-time",
            "description" : "ISO-8601 with offset; the booked length is kept"
          }
        },
        "required" : [ "start" ]
      },
      "SlotsResponse" : {
        "type" : "object",
        "properties" : {
          "day" : {
            "type" : "string",
            "format" : "date"
          },
          "durationMin" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "service length in minutes"
          },
          "starts" : {
            "type" : "array",
            "description" : "free start times, ISO-8601 with the master's UTC offset",
            "items" : {
              "type" : "string",
              "format" : "date-time"
            }
          },
          "timeZone" : {
            "type" : "string",
            "description" : "IANA time zone of the master"
          }
        },
        "required" : [ "day", "durationMin", "starts", "timeZone" ]
      },
      "UpdateClientRequest" : {
        "type" : "object",
        "properties" : {
          "name" : {
            "type" : "string",
            "description" : "blank clears the name",
            "maxLength" : 100,
            "minLength" : 0
          },
          "notes" : {
            "type" : "string",
            "description" : "blank clears the notes",
            "maxLength" : 2000,
            "minLength" : 0
          }
        }
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
