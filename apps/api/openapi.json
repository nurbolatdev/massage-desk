{
  "openapi" : "3.1.0",
  "info" : {
    "description" : "REST API for the massage-desk app and admin panel",
    "title" : "massage-desk API",
    "version" : "v1"
  },
  "servers" : [ {
    "url" : "/"
  } ],
  "security" : [ {
    "bearerAuth" : [ ]
  } ],
  "paths" : {
    "/slots" : {
      "get" : {
        "operationId" : "slots",
        "parameters" : [ {
          "description" : "id of an active service",
          "in" : "query",
          "name" : "serviceId",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "uuid"
          }
        }, {
          "description" : "local date in the master's time zone, YYYY-MM-DD",
          "in" : "query",
          "name" : "day",
          "required" : true,
          "schema" : {
            "type" : "string",
            "format" : "date"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "application/json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/SlotsResponse"
                }
              }
            },
            "description" : "free start times, possibly empty"
          },
          "400" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "invalid or missing serviceId or day"
          },
          "404" : {
            "content" : {
              "application/problem+json" : {
                "schema" : {
                  "$ref" : "#/components/schemas/ProblemDetail"
                }
              }
            },
            "description" : "service not found or inactive"
          }
        },
        "summary" : "Free start times for a service on a day",
        "tags" : [ "schedule" ]
      }
    },
    "/webhook/whatsapp" : {
      "get" : {
        "operationId" : "verify",
        "parameters" : [ {
          "in" : "query",
          "name" : "hub.mode",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "hub.verify_token",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        }, {
          "in" : "query",
          "name" : "hub.challenge",
          "required" : false,
          "schema" : {
            "type" : "string"
          }
        } ],
        "responses" : {
          "200" : {
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            },
            "description" : "challenge echoed"
          },
          "403" : {
            "content" : {
              "text/plain" : {
                "schema" : {
                  "type" : "string"
                }
              }
            },
            "description" : "wrong or missing verify token"
          }
        },
        "security" : [ ],
        "summary" : "Meta webhook verification",
        "tags" : [ "webhook" ]
      }
    }
  },
  "components" : {
    "schemas" : {
      "ProblemDetail" : {
        "type" : "object",
        "properties" : {
          "detail" : {
            "type" : "string"
          },
          "instance" : {
            "type" : "string",
            "format" : "uri"
          },
          "properties" : {
            "type" : "object",
            "additionalProperties" : { }
          },
          "status" : {
            "type" : "integer",
            "format" : "int32"
          },
          "title" : {
            "type" : "string"
          },
          "type" : {
            "type" : "string",
            "format" : "uri"
          }
        }
      },
      "SlotsResponse" : {
        "type" : "object",
        "properties" : {
          "day" : {
            "type" : "string",
            "format" : "date"
          },
          "durationMin" : {
            "type" : "integer",
            "format" : "int32",
            "description" : "service length in minutes"
          },
          "starts" : {
            "type" : "array",
            "description" : "free start times, ISO-8601 with the master's UTC offset",
            "items" : {
              "type" : "string",
              "format" : "date-time"
            }
          },
          "timeZone" : {
            "type" : "string",
            "description" : "IANA time zone of the master"
          }
        },
        "required" : [ "day", "durationMin", "starts", "timeZone" ]
      }
    },
    "securitySchemes" : {
      "bearerAuth" : {
        "bearerFormat" : "JWT",
        "scheme" : "bearer",
        "type" : "http"
      }
    }
  }
}
