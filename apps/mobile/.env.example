# API address. On a phone use the computer's Wi-Fi address: http://<IP of the computer>:8080
EXPO_PUBLIC_API_URL=http://localhost:8080
# Project Settings -> API keys in the Supabase dashboard. Both values are public client values.
# The legacy anon key also works in the publishable key variable.
EXPO_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
EXPO_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
